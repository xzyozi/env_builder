{
  "//": "接続対象の定義テンプレート。init_config スクリプトでこのファイルを servers.json にコピーし、実値を埋めて使う。servers.json は .gitignore で除外される。",
  "bastion": {
    "//": "踏み台サーバ。TeraTerm(TTL)で接続確認済みの手順に対応させる。",
    "host": "BASTION_HOST",
    "port": 22,
    "user": "BASTION_USER",
    "auth": {
      "//": "auth.method は 'password' または 'key'",
      "method": "key",
      "key_path": "~/.ssh/id_rsa",
      "password_env": "ENVB_BASTION_PASSWORD"
    }
  },
  "src": {
    "//": "参照元サーバ（構築済み。ここを参考に環境を揃える）",
    "host": "SRC_HOST",
    "port": 22,
    "user": "SRC_USER",
    "proxy_jump": "bastion",
    "auth": {
      "method": "key",
      "key_path": "~/.ssh/id_rsa",
      "password_env": "ENVB_SRC_PASSWORD"
    },
    "become_user": null
  },
  "dst": {
    "//": "構築先サーバ（ここで build を通す）",
    "host": "DST_HOST",
    "port": 22,
    "user": "DST_USER",
    "proxy_jump": "bastion",
    "auth": {
      "method": "key",
      "key_path": "~/.ssh/id_rsa",
      "password_env": "ENVB_DST_PASSWORD"
    },
    "//become": "build 用ユーザーへ切り替える場合に指定（sudo -iu / su -）。不要なら null。",
    "become_user": null,
    "become_method": "sudo"
  }
}
